# bleepblorp 0.2 — copy this file to .env.local and fill in YOUR keys.
# Never email, stream, or zip a filled-in .env.local.

# EDUCATIONAL PAPER ASSISTANT. Not financial advice. All trading involves risk.
# You are solely responsible for how you use this software.

# Recommended for a home / solo install (snappier Kalshi loops):
BLEEPBLORP_STANDALONE=1

# --- Kalshi API (recommended) ---
# Option A: path to a credentials file (Python-style, see the manual)
# KALSHI_CREDENTIALS_FILE=C:\path\to\your\kalshi-keys.py

# Option B: paste values here (avoid this while screen-sharing)
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY=

# Optional overrides (defaults are the public Kalshi API)
# KALSHI_REST_BASE=https://external-api.kalshi.com/trade-api/v2
# KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2

# Optional: probe a co-located live bot health URL (leave unset at home)
# BLEEPBLORP_COMPANION_HEALTH_URL=http://127.0.0.1:8788/health
