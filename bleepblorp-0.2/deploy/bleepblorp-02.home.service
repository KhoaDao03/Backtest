[Unit]
Description=bleepblorp 0.2 educational paper trading assistant (home / Strategist)
Documentation=file:/opt/bleepblorp-02/README.md
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=bleepblorp
Group=bleepblorp
WorkingDirectory=/opt/bleepblorp-02

Environment=NODE_ENV=production
Environment=PORT=3001
Environment=BLEEPBLORP_STANDALONE=1

ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3001
ExecStartPost=/bin/bash -c 'sleep 4; curl -sf --max-time 8 http://127.0.0.1:3001/api/status >/dev/null || true'

TimeoutStopSec=20
Restart=always
RestartSec=10s

StandardOutput=append:/var/log/bleepblorp-02/out.log
StandardError=append:/var/log/bleepblorp-02/err.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/bleepblorp-02/logs /opt/bleepblorp-02/.next /var/log/bleepblorp-02

[Install]
WantedBy=multi-user.target
